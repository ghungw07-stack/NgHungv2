ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_password_here
OPENAI_API_KEY=your_openai_api_key_here
SERPAPI_KEYS=your_serpapi_key_here

# Keep group messages available for the web conversation view. Set to 0 only
# when group history and live group updates are intentionally disabled.
NGH_GROUP_MESSAGE_LOG=1
NGH_GROUP_FILE_LOG=1
NGH_MESSAGE_FILE_LOG=1
NGH_WS_FORENSIC_LOG=1
NGH_VERBOSE_MESSAGE_LOG=1
NGH_SQL_LOG_LEVEL=error

# Runtime queue: preserve four real slots for commands/direct messages and
# discard stale ordinary bursts before they can consume seconds of CPU/RAM.
NGH_GLOBAL_MESSAGE_CONCURRENCY=8
NGH_GLOBAL_MESSAGE_BASE_CONCURRENCY=6
NGH_GLOBAL_MESSAGE_MIN_CONCURRENCY=2
NGH_INTERACTIVE_MESSAGE_RESERVE=2
NGH_NORMAL_MESSAGE_BACKLOG=500
NGH_MESSAGE_BACKLOG_PER_THREAD=120
NGH_CHILD_MAX_OLD_SPACE_MB=384
NGH_CHILD_RSS_RESTART_MB=600
NGH_QUEUE_RSS_PRESSURE_BYTES=524288000
NGH_BACKGROUND_CONCURRENCY=2
NGH_MESSAGE_MEMORY_PER_THREAD=100
NGH_MESSAGE_BUG_SCAN=0
NGH_RSS_WARN_BYTES=524288000
NGH_IMAGE_BUFFER_CACHE_BYTES=33554432
NGH_GROUP_CACHE_SIZE=75
NGH_USER_CACHE_SIZE=1500
NGH_RECENT_CHAT_USERS=1000
NGH_RECENT_CHAT_PER_USER=20
NGH_SHARP_CACHE_MEMORY_MB=32
NGH_UPLOAD_RATE_LIMIT_COOLDOWN_MS=60000
NGH_COMMAND_LATENCY_LOG=1

NGH_UPLOAD_URL=https://upload.example.com/api/upload.php
NGH_UPLOAD_TOKEN=your_upload_token_here
WEBHOOK_SECRET=your_webhook_secret_here
ZALO_PROXY_URL=

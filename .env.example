ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_password_here
OPENAI_API_KEY=your_openai_api_key_here
SERPAPI_KEYS=your_serpapi_key_here

# Disable group message/event/forensic logs. Operational error logs remain on.
NGH_GROUP_MESSAGE_LOG=1
NGH_GROUP_FILE_LOG=1
NGH_MESSAGE_FILE_LOG=1
NGH_WS_FORENSIC_LOG=1
NGH_VERBOSE_MESSAGE_LOG=1
NGH_SQL_LOG_LEVEL=error

# Runtime queue: preserve four real slots for commands/direct messages and
# discard stale ordinary bursts before they can consume seconds of CPU/RAM.
NGH_GLOBAL_MESSAGE_CONCURRENCY=48
NGH_GLOBAL_MESSAGE_BASE_CONCURRENCY=24
NGH_GLOBAL_MESSAGE_MIN_CONCURRENCY=12
NGH_INTERACTIVE_MESSAGE_RESERVE=8
NGH_NORMAL_MESSAGE_BACKLOG=500
NGH_MESSAGE_BACKLOG_PER_THREAD=120
NGH_CHILD_MAX_OLD_SPACE_MB=2048
NGH_QUEUE_RSS_PRESSURE_BYTES=2684354560
NGH_BACKGROUND_CONCURRENCY=2
NGH_MESSAGE_MEMORY_PER_THREAD=100
NGH_MESSAGE_BUG_SCAN=0
NGH_COMMAND_LATENCY_LOG=1

NGH_UPLOAD_URL=https://upload.example.com/api/upload.php
NGH_UPLOAD_TOKEN=your_upload_token_here
WEBHOOK_SECRET=your_webhook_secret_here
ZALO_PROXY_URL=
